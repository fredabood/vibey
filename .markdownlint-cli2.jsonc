// markdownlint-cli2 configuration — LAB-1479
//
// This repo had NO config, so any lint run judged it against markdownlint's
// defaults — a standard nobody here chose. Measured 2026-08-23 across 62 files:
// 1,930 findings, of which 1,485 come from three rules the homelab repo already
// evaluated and disabled with recorded reasons (LAB-1368). Those decisions are
// adopted verbatim here rather than re-litigated: this repo is a sibling of
// fredabood/homelab with the same authors and the same documentation style, and
// two different standards for the same prose is worse than either one.
//
// The ~445 findings this config does NOT silence are the mechanically fixable
// ones (blanks around lists/fences/headings, consecutive blanks, ordered-list
// prefixes). They are a burn-down, not a policy question, and are deliberately
// left visible so they can be cleared rather than hidden.
{
  "globs": ["**/*.md"],

  "ignores": [
    "**/node_modules/**",
    "**/.venv/**",
    // Worktrees live inside the superproject at .claude/worktrees/<name>;
    // without this a checked-out worktree lints itself recursively.
    "worktrees/**",
    "**/CHANGELOG.md"
  ],

  "config": {
    // 1,088 findings, all in prose and tables that read fine as written.
    // Wrapping documentation to a column count is a style preference, not a
    // correctness property — and these files are read by agents, not printed.
    "MD013": false,

    // 310 — table pipe spacing. A very new, purely cosmetic rule; every
    // residual is inside a table that renders correctly today.
    "MD060": false,

    // 68 — a code fence with no language. Many are console transcripts, tool
    // invocation lists, or mixed output where no language is correct. Worth a
    // burn-down, not a gate.
    "MD040": false,

    // 9 — inline HTML, used deliberately for <details> blocks and for tables
    // that markdown cannot express.
    "MD033": false,

    // 9 — first line must be a top-level heading. Skill and agent files open
    // with YAML frontmatter by design; that IS the format.
    "MD041": false,

    // Bold-as-heading. House style: these are lead-ins inside a section, not
    // headings, and promoting them would change the document outline.
    "MD036": false,

    // Duplicate headings are legitimate: rule files repeat "Rules" / "Usage" /
    // "Examples" under different sections.
    "MD024": { "siblings_only": true }
  }
}
