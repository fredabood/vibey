{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Bash(brew *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(jq *)",
      "Bash(bash *)",
      "Bash(curl *)",
      "Bash(xcode-select *)",
      "Bash(cd *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(ln *)",
      "Bash(rm *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(source *)",
      "Bash(eval *)",
      "Bash(chmod *)",
      "Bash(ssh *)",
      "Bash(databricks *)",
      "Bash(python *)",
      "Bash(nohup *)",
      "Bash(tr *)",
      "Bash(test *)",
      "Bash(date *)",
      "Bash(sleep *)",
      "Bash(jobs *)",
      "WebFetch(domain:www.databricks.com)",
      "WebFetch(domain:docs.databricks.com)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docker-safety-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/env-secret-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/link-direction-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ticket-reference-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-frontmatter-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-tests.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/label-taxonomy-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/github-skill-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle-field-check.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/env-secret-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking workflow gates..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking workflow gates..."
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/github-skill-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking skill execution context..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/label-taxonomy-check.sh",
            "timeout": 10,
            "statusMessage": "Validating taxonomy labels..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle-field-check.sh",
            "timeout": 30,
            "statusMessage": "Checking lifecycle completeness..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking workflow gates..."
          }
        ]
      },
      {
        "matcher": "mcp__github__projects_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/github-skill-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      },
      {
        "matcher": "mcp__github__add_issue_comment",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/github-skill-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      },
      {
        "matcher": "mcp__github__sub_issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/github-skill-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__github__projects_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/jira-graph-sync.sh",
            "timeout": 30,
            "statusMessage": "Syncing board status to the mirror..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/jira-graph-sync.sh",
            "timeout": 30,
            "statusMessage": "Syncing board status to the mirror..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/persistence-safety-net.sh",
            "timeout": 15,
            "statusMessage": "Checking session persistence..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prompt-router.sh",
            "timeout": 5000,
            "statusMessage": "Checking for skill suggestions..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "databricks@claude-plugins-official": true
  }
}
